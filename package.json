{
  "name": "e-means",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript port of e-means (Meta FAIR's mini-batch replacement for k-means) plus a Lloyd's k-means baseline. Runs in Node, browsers, Cloudflare Workers, Vercel Edge Functions, and Deno.",
  "keywords": [
    "e-means",
    "k-means",
    "clustering",
    "machine-learning",
    "vector-search",
    "embeddings",
    "typescript",
    "javascript",
    "edge",
    "cloudflare-workers",
    "vercel",
    "web-worker",
    "rag"
  ],
  "license": "MIT",
  "author": "Krish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TODO-set-after-repo-creation/e-means-ts.git"
  },
  "homepage": "https://github.com/TODO-set-after-repo-creation/e-means-ts#readme",
  "bugs": {
    "url": "https://github.com/TODO-set-after-repo-creation/e-means-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "NOTICE"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "bench": "tsx bench/run.ts"
  },
  "devDependencies": {
    "ml-kmeans": "^7.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
